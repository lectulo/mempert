{
  "name": "memesave-bot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:server && bun --watch dist/server.js",
    "start": "bun dist/server.js",
    "build": "bun run build:app && bun run build:server",
    "build:server": "bun scripts/build-server.ts",
    "test": "bun run test:runtime && bun run test:oauth",
    "test:runtime": "bun run build:server && bun test test/runtime test/server test/polling-acceptance src/runtime/jobs.test.ts src/runtime/jobs-recovery.test.ts test/integration-local",
    "test:cloudflare": "vitest run",
    "test:oauth": "bun test test/oauth-local",
    "test:go-e2e": "bun test test/go-e2e",
    "typecheck": "tsc",
    "migrate:cloudflare:local": "wrangler d1 migrations apply memesave --local",
    "migrate:cloudflare:remote": "wrangler d1 migrations apply memesave --remote",
    "setup": "bun scripts/setup.ts",
    "build:app": "vite build --config app/vite.config.ts",
    "dev:app": "vite --config app/vite.config.ts"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@grammyjs/auto-retry": "^2.0.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@resvg/resvg-js": "^2.6.2",
    "aws4fetch": "^1.0.20",
    "fflate": "0.8.2",
    "grammy": "^1.46.0",
    "undici": "^7.29.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "^5.20261024.1",
    "@cofob2/design-system-css": "^0.5.0",
    "@cofob2/design-system-svelte": "^0.5.0",
    "@lucide/svelte": "^1.61.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "@types/bun": "1.3.14",
    "echarts": "^6.1.0",
    "minisearch": "^7.2.0",
    "socks": "^2.8.7",
    "socks-proxy-agent": "^8.0.5",
    "svelte": "^5.57.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.0",
    "wrangler": "^4.152.0"
  }
}
