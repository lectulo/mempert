# Polling receives bot messages without a public endpoint. Use an origin without a path.
PUBLIC_URL=http://localhost:3000
# Website Telegram login and OpenRouter fetching signed media still need a reachable
# public HTTPS origin (and Telegram Login credentials); localhost is not enough for those.
# TLS terminates at your existing reverse proxy when using a public domain.
# Signed local media links use PUBLIC_URL; MEDIA_URL is set automatically.
# Do not copy legacy Cloudflare identifiers/keys.
APP_BIND=127.0.0.1
APP_PORT=3000
# Optional alternate repo-local env file for isolated Compose projects.
# APP_ENV_FILE=.env

# Telegram: create the bot in @BotFather. ADMIN_ID is your numeric Telegram user id.
BOT_TOKEN=
ADMIN_ID=
# polling (default): app removes any webhook, preserves pending updates and polls.
# webhook: requires public HTTPS PUBLIC_URL and WEBHOOK_SECRET; run setup explicitly.
TELEGRAM_MODE=polling
# Optional shared outbound proxy for Telegram Bot API/Login and OpenRouter API.
# Empty means direct for both; internal services and source sites stay direct.
# Supports http://, https:// and socks5://; URL-encode optional user/password.
# Example: socks5://proxy.example:1080 (not an inbound reverse proxy).
OUTBOUND_PROXY_URL=
# Only required for webhook mode; use a separate random secret.
WEBHOOK_SECRET=
# Optional for bot polling, required for website login: BotFather Telegram Login
# client secret; configure the public origin/redirect there.
TG_CLIENT_SECRET=
# Optional: private storage channel where the bot is an administrator.
STORAGE_CHAT_ID=

# Required external AI backend. Apply a spending cap in OpenRouter.
OPENROUTER_API_KEY=
# Separate random secrets (e.g. openssl rand -hex 32); retain ENCRYPTION_KEY in backups.
ENCRYPTION_KEY=
WORKER_SECRET=
SCRAPER_API_KEY=

# The Compose file enforces these local services and storage paths.
SELF_HOSTED=true
DB_PATH=/data/app.sqlite
MEDIA_ROOT=/data/media
PORT=3000
THUMB_URL=http://thumb:8080
SCRAPER_URL=http://scraper:8080
COBALT_URL=http://cobalt:9000/
# Official upstream image; for reproducibility pin a tested sha256 digest here.
COBALT_IMAGE=ghcr.io/imputnet/cobalt:11

# Optional TikTok profile only. Obtain an API token after signing in to this instance.
TIKTOK_API_TOKEN=
TIKTOK_INTERVAL=1800
TIKTOK_BACKFILL=50
